# Lấy key miễn phí tại https://aistudio.google.com/apikey
# Để trống thì app chạy ở chế độ demo (nội dung mẫu + nền gradient, không gọi AI).
GEMINI_API_KEY=

# Tuỳ chọn: đổi model
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Tuỳ chọn: đường dẫn Chromium. Mặc định dùng Google Chrome đã cài trên máy.
# CHROMIUM_PATH=/path/to/chromium

# Tuỳ chọn: Groq viết nội dung (nhanh, rẻ). Có key này thì ưu tiên dùng cho phần chữ.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
